  "item": [
    {
      "name": "Auth - Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is not 500', function () {",
              "    pm.expect(pm.response.code, 'response body: ' + pm.response.text()).to.not.equal(500);",
              "});",
              "",
              "pm.test('Response is JSON when provided', function () {",
              "    const contentType = pm.response.headers.get('Content-Type') || '';",
              "    if (contentType) {",
              "        pm.expect(contentType.toLowerCase()).to.include('application/json');",
              "    }",
              "});",
              "",
              "let responseJson = null;",
              "try {",
              "    responseJson = pm.response.json();",
              "} catch (e) {}",
              "",
              "console.log('Signup diagnostic', {",
              "    requestUrl: pm.request.url.toString(),",
              "    requestBody: pm.request.body ? pm.request.body.raw : null,",
              "    status: pm.response.code,",
              "    responseText: pm.response.text(),",
              "    responseJson,",
              "    responseHeaders: pm.response.headers.toJSON()",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ryan\",\n  \"email\": \"Ryan@test.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        }
      },
      "response": []
    },
